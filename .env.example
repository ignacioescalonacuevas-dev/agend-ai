# ── Base de datos ────────────────────────────────────────────────────────
# Postgres local (Supabase local o cluster desechable de scripts/test-db.sh).
# Nunca apuntar un entorno de desarrollo a datos reales (Ley 21.719).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# ── Supabase (auth + RLS, hito 6) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── WhatsApp Cloud API (hito 3+; adaptador mock mientras no haya credenciales)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Twilio, solo SMS (hito 3+) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Tokens firmados de un solo uso para la página pública (hito 4) ───────
RESPUESTA_TOKEN_SECRET=

# ── Orquestador (hito 3) ─────────────────────────────────────────────────
# Base pública para los enlaces del SMS de respuesta de un toque.
BASE_URL_RESPUESTA=http://localhost:3000
